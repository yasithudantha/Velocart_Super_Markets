# ========================================
# Velocart - Environment Variables Template
# ========================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# --- Hosting Toggles ---
Backend=True
Frontend=False
AI_Agent=False
COMPOSE_PROFILES=backend,frontend,ai_agent

# --- AI Configuration ---
# Choose "local" (Ollama/CUDA) or "gemini" (Gemini API)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# --- ASP.NET Core JWT ---
Jwt__Key=your_jwt_secret_at_least_32_chars_long
Jwt__Issuer=VelocartAPI
Jwt__Audience=VelocartClients

# --- Google OAuth ---
Google__ClientId=your_google_oauth_client_id

# --- Email (SMTP) ---
EmailConfiguration__SmtpUsername=your_email@gmail.com
EmailConfiguration__SmtpPassword=your_gmail_app_password

# --- Stripe Payments ---
Stripe__SecretKey=sk_test_your_stripe_secret_key
Stripe__WebhookSecret=whsec_your_webhook_secret

# --- Cloudinary (Image Uploads) ---
Cloudinary__CloudName=your_cloudinary_cloud_name
Cloudinary__ApiKey=your_cloudinary_api_key
Cloudinary__ApiSecret=your_cloudinary_api_secret

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=velocart_db
DB_CONNECTION_STRING=Host=localhost;Database=velocart_db;Username=postgres;Password=your_db_password

